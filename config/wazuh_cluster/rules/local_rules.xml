<!--
  Rule cho audit log JSON cua Coraza WAF (lab wazuh-lab).
  Event do agent doc /var/log/coraza/audit.log voi log_format json, decoder json tu bat field.
  ID custom dung dai 100000-120000.
-->
<group name="coraza,waf,web,">

  <!-- Goc: moi transaction Coraza ghi audit log -->
  <rule id="100200" level="3">
    <decoded_as>json</decoded_as>
    <field name="log_source">^coraza$</field>
    <field name="transaction.id">\.+</field>
    <description>Coraza WAF: transaction tu $(transaction.client_ip) $(transaction.request.method) $(transaction.request.uri)</description>
  </rule>

  <!-- CRS danh gia anomaly score vuot nguong (rule 949110) = request bi coi la tan cong -->
  <!-- ../etc/passwd khop ca tag LFI lan RCE. Wazuh xet rule con level cao truoc, cung level thi theo thu tu,
       nen LFI de level 12 va dat truoc RCE -->
  <rule id="100201" level="10">
    <if_sid>100200</if_sid>
    <match>Inbound Anomaly Score Exceeded</match>
    <description>Coraza WAF: request vuot anomaly score tu $(transaction.client_ip) $(transaction.request.method) $(transaction.request.uri)</description>
    <group>attack,</group>
  </rule>

  <rule id="100210" level="10">
    <if_sid>100201</if_sid>
    <match>attack-sqli</match>
    <description>Coraza WAF: SQL injection tu $(transaction.client_ip) $(transaction.request.method) $(transaction.request.uri)</description>
    <mitre><id>T1190</id></mitre>
    <group>attack,sql_injection,</group>
  </rule>

  <rule id="100211" level="10">
    <if_sid>100201</if_sid>
    <match>attack-xss</match>
    <description>Coraza WAF: XSS tu $(transaction.client_ip) $(transaction.request.method) $(transaction.request.uri)</description>
    <mitre><id>T1190</id></mitre>
    <group>attack,xss,</group>
  </rule>

  <rule id="100212" level="12">
    <if_sid>100201</if_sid>
    <match>attack-lfi</match>
    <description>Coraza WAF: Path traversal / LFI tu $(transaction.client_ip) $(transaction.request.method) $(transaction.request.uri)</description>
    <mitre><id>T1190</id></mitre>
    <group>attack,</group>
  </rule>

  <rule id="100213" level="12">
    <if_sid>100201</if_sid>
    <match>attack-rce</match>
    <description>Coraza WAF: Remote command execution tu $(transaction.client_ip) $(transaction.request.method) $(transaction.request.uri)</description>
    <mitre><id>T1190</id></mitre>
    <group>attack,</group>
  </rule>

  <!-- Nhieu request tan cong tu cung 1 IP trong 60s = scanner (sqlmap, nikto...) -->
  <rule id="100220" level="12" frequency="8" timeframe="60">
    <if_matched_group>attack</if_matched_group>
    <same_field>transaction.client_ip</same_field>
    <description>Coraza WAF: nhieu request tan cong tu $(transaction.client_ip) trong 60s (kha nang scanner)</description>
    <mitre><id>T1595</id></mitre>
    <group>attack,web_scan,</group>
  </rule>

</group>

<!--
  Rule cho Sysmon for Linux (decoder sysmon-linux trong local_decoder.xml). ID 100300-100399.
  Sysmon tren server ghi rat nhieu event (moi process, moi ket noi), nen rule goc de level 0
  (khong tao alert) va chi bat cac hanh vi dang ngo.
-->
<group name="sysmon,sysmon_linux,">

  <rule id="100300" level="0">
    <decoded_as>sysmon-linux</decoded_as>
    <description>Sysmon Linux: event $(sysmon.eventid)</description>
  </rule>

  <!-- EventID 1: ProcessCreate -->
  <rule id="100301" level="0">
    <if_sid>100300</if_sid>
    <field name="sysmon.eventid">^1$</field>
    <description>Sysmon Linux: tao process $(sysmon.image)</description>
  </rule>

  <rule id="100310" level="12">
    <if_sid>100301</if_sid>
    <field name="sysmon.commandline" type="pcre2">/dev/(tcp|udp)/|\bbash -i\b|\bn(c|cat)\b.*\s-(e|c)\s|pty\.spawn|socat\b.*exec:|\bsh -i\b</field>
    <description>Sysmon Linux: nghi reverse shell - $(sysmon.user) chay: $(sysmon.commandline)</description>
    <mitre><id>T1059.004</id></mitre>
    <group>attack,</group>
  </rule>

  <rule id="100311" level="10">
    <if_sid>100301</if_sid>
    <field name="sysmon.commandline" type="pcre2">\b(curl|wget)\b.*\|\s*(sudo\s+)?(ba|z|da)?sh\b</field>
    <description>Sysmon Linux: tai script ve chay thang (curl/wget | sh) - $(sysmon.user): $(sysmon.commandline)</description>
    <mitre><id>T1105</id></mitre>
    <group>attack,</group>
  </rule>

  <rule id="100312" level="10">
    <if_sid>100301</if_sid>
    <field name="sysmon.commandline" type="pcre2">/etc/shadow|/etc/gshadow|\.ssh/id_(rsa|ed25519|ecdsa)\b</field>
    <description>Sysmon Linux: truy cap file nhay cam - $(sysmon.user): $(sysmon.commandline)</description>
    <mitre><id>T1003.008</id></mitre>
    <group>attack,</group>
  </rule>

  <rule id="100313" level="8">
    <if_sid>100301</if_sid>
    <field name="sysmon.image" type="pcre2">/(useradd|adduser|usermod|userdel|passwd|chpasswd)$</field>
    <description>Sysmon Linux: thay doi tai khoan - $(sysmon.user): $(sysmon.commandline)</description>
    <mitre><id>T1136.001</id></mitre>
  </rule>

  <!-- EventID 3: NetworkConnect toi port hay dung cho reverse shell / C2 -->
  <rule id="100320" level="10">
    <if_sid>100300</if_sid>
    <field name="sysmon.eventid">^3$</field>
    <field name="sysmon.destinationport" type="pcre2">^(4444|4445|1337|31337|5555|6666|9001)$</field>
    <description>Sysmon Linux: $(sysmon.image) ket noi toi $(sysmon.destinationip):$(sysmon.destinationport) (port hay dung cho reverse shell/C2)</description>
    <mitre><id>T1571</id></mitre>
    <group>attack,</group>
  </rule>

  <!-- EventID 11: FileCreate o vi tri persistence -->
  <rule id="100330" level="10">
    <if_sid>100300</if_sid>
    <field name="sysmon.eventid">^11$</field>
    <field name="sysmon.targetfilename" type="pcre2">^/etc/(cron\.(d|daily|hourly|weekly|monthly)/|crontab$)|^/var/spool/cron/|^/etc/systemd/system/|/\.ssh/authorized_keys$|^/etc/sudoers\.d/</field>
    <description>Sysmon Linux: tao file o vi tri persistence $(sysmon.targetfilename) boi $(sysmon.image)</description>
    <mitre><id>T1053.003</id></mitre>
    <group>attack,</group>
  </rule>

</group>

<!-- Group rieng: rule.groups co ids,suricata (giong rule goc 86601), khong ke thua sysmon -->
<group name="ids,suricata,">
  <!-- Suricata: Wazuh co san 86600 (moi event, level 0) va 86601 (event_type alert, level 3).
       Chi nang level alert ma Suricata xep nang (severity 1-2) de ve Zalo/Telegram, severity 3+ giu level 3. -->
  <rule id="100340" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.severity" type="pcre2">^1$</field>
    <description>Suricata: $(alert.signature) ($(src_ip) -> $(dest_ip):$(dest_port))</description>
    <group>suricata_high,attack,</group>
  </rule>

  <rule id="100341" level="10">
    <if_sid>86601</if_sid>
    <field name="alert.severity" type="pcre2">^2$</field>
    <description>Suricata: $(alert.signature) ($(src_ip) -> $(dest_ip):$(dest_port))</description>
    <group>suricata_high,attack,</group>
  </rule>

  <!-- Signature IP reputation/blocklist (ET DROP Spamhaus/Dshield, ET CINS, ET COMPROMISED): chi bao
       "IP nguon nam trong blocklist", khong noi gi ve payload. Server public nen IP ngoai internet quet vao
       lien tuc -> spam bot. Ha xuong level 3 (duoi nguong Zalo/Telegram = 7) nhung van ghi alert vao
       indexer de tra cuu (rule.id:100342). Ket noi tu cac IP nay ma co payload tan cong that
       thi signature khac (sev1/sev2) van ban qua 100340/100341. -->
  <rule id="100342" level="3">
    <if_sid>100341</if_sid>
    <field name="alert.signature" type="pcre2">^ET (DROP Spamhaus|DROP Dshield|CINS Active Threat Intelligence|COMPROMISED Known Compromised)</field>
    <description>Suricata (IP reputation, khong gui bot): $(alert.signature) ($(src_ip) -> $(dest_ip):$(dest_port))</description>
    <group>suricata_reputation,</group>
  </rule>

</group>

<!-- ML anomaly (do an, stack ~/ml-anomaly): to hop IF + LOF + OCSVM cham diem flow Argus, nids-collector ghi /var/log/ml-anomaly/alerts.jsonl.
     Chi noi vao Wazuh SAU khi hieu chinh nguong tren traffic benign cua lab, khong thi bao nham nhieu. -->
<group name="nids,dacn_ml,">
  <rule id="100500" level="8">
    <decoded_as>json</decoded_as>
    <field name="nids">^dacn-ml$</field>
    <description>NIDS ML: flow bat thuong $(src_ip) -> $(dst_ip):$(dst_port)/$(proto), diem $(score) (nguong $(threshold))</description>
    <group>anomaly,</group>
  </rule>

  <!-- Nhieu flow bat thuong tu cung 1 nguon trong 60s: nghi bruteforce / quet / DoS -->
  <rule id="100501" level="12" frequency="20" timeframe="60">
    <if_matched_sid>100500</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>NIDS ML: tu 20 flow bat thuong trong 60s tu $(src_ip) (nghi bruteforce/quet/DoS)</description>
    <group>anomaly,attack,</group>
  </rule>

</group>
